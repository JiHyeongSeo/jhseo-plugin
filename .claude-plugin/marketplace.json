{
  "name": "sol-plugins",
  "owner": {
    "name": "SOL Team",
    "email": "sol@nexon.com"
  },
  "metadata": {
    "description": "SOL 팀 Claude Code 플러그인 모음",
    "version": "1.0.0"
  },
  "plugins": [
    {
      "name": "confluence",
      "source": "./plugins/confluence",
      "description": "Confluence 페이지 검색/조회/생성/수정. 유해탐지팀 컨플루언스 문서 관리용",
      "version": "1.0.3",
      "author": {
        "name": "SOL Team"
      },
      "keywords": [
        "confluence",
        "documentation",
        "wiki",
        "컨플루언스",
        "컨플",
        "문서"
      ],
      "category": "productivity"
    },
    {
      "name": "sol",
      "source": "./plugins/code-review",
      "description": "AI 기반 심층 코드리뷰. 4개 카테고리 검토 + 선택한 이슈 자동 수정",
      "version": "1.4.1",
      "author": {
        "name": "SOL Team"
      },
      "keywords": [
        "code-review",
        "git",
        "security",
        "performance",
        "코드리뷰",
        "auto-fix"
      ],
      "category": "development"
    },
    {
      "name": "detection-log",
      "source": "./plugins/detection-log",
      "description": "Elasticsearch 탐지 로그 조회. 텍스트/이미지 탐지 API 호출 로그 검색 및 통계 분석",
      "version": "1.0.6",
      "author": {
        "name": "SOL Team"
      },
      "keywords": ["elasticsearch", "detection", "log", "탐지", "로그", "통계"],
      "category": "monitoring"
    },
    {
      "name": "service-lookup",
      "source": "./plugins/service-lookup",
      "description": "서비스 ID 조회. NXLOG/BWS 서비스 ID를 게임명/메모로 검색",
      "version": "1.0.3",
      "author": {
        "name": "SOL Team"
      },
      "keywords": ["service", "serviceid", "서비스", "게임", "lookup"],
      "category": "utility"
    },
    {
      "name": "interactive-review",
      "source": "./plugins/interactive-review",
      "description": "웹 기반 인터랙티브 질문/Plan 리뷰 UI. 여러 질문을 한 화면에 표시하거나 Plan을 GitHub PR 리뷰 스타일로 검토",
      "version": "1.0.0",
      "author": {
        "name": "SOL Team"
      },
      "keywords": ["interactive", "review", "questions", "plan", "web-ui", "질문", "리뷰"],
      "category": "utility"
    }
  ]
}
