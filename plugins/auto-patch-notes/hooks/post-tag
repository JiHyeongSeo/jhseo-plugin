#!/bin/bash
# Git post-tag hook
# 태그 생성 시 자동으로 배포 노트를 생성합니다

# 현재 생성된 태그 가져오기
TAG=$(git describe --tags --exact-match 2>/dev/null)

if [ -z "$TAG" ]; then
    echo "No tag found"
    exit 0
fi

# 태그 형식 검증: {env}-v{version}
if ! echo "$TAG" | grep -qE "^(dev|stage|prod)-v[0-9]+\.[0-9]+\.[0-9]+$"; then
    echo "Tag format does not match deployment pattern: $TAG"
    echo "Expected format: {env}-v{version} (e.g., dev-v1.2.3)"
    exit 0
fi

echo "=== Deployment Note Auto-Generation ==="
echo "Tag: $TAG"

# Claude plugin root 찾기
PLUGIN_ROOT=$(dirname "$(dirname "$(readlink -f "$0")")")
DEPLOYMENT_SCRIPT="$PLUGIN_ROOT/deployment.py"

if [ ! -f "$DEPLOYMENT_SCRIPT" ]; then
    echo "Error: deployment.py not found at $DEPLOYMENT_SCRIPT"
    exit 1
fi

# 배포 노트 생성 (비대화형 모드)
echo "Generating deployment notes..."
python3 "$DEPLOYMENT_SCRIPT" create --tag "$TAG" --no-interactive

if [ $? -eq 0 ]; then
    echo "✓ Deployment notes created successfully"
    echo "  - Patch note: Created"
    echo "  - Release note: Created"
else
    echo "✗ Failed to create deployment notes"
    exit 1
fi
